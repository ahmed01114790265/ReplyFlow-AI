@model VerifyResetCodeViewModel

@{
    ViewData["Title"] = "Verify Reset Code";
}

<h2>Verify Reset Code</h2>

<form asp-action="VerifyResetCode"
      asp-controller="Account"
      method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input asp-for="PhoneNumber" type="hidden" />

    <div class="mb-3">
        <label asp-for="ResetCode" class="form-label"></label>

        <input asp-for="ResetCode" class="form-control" />

        <span asp-validation-for="ResetCode"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Verify Code
    </button>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}